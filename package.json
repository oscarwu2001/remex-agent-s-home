{
  "name": "agents-home",
  "productName": "Agents Home",
  "version": "0.1.0",
  "private": true,
  "description": "A Monument Valley-style isometric hospital where your Claude Code agents live and work.",
  "main": "electron/main.js",
  "author": "Oscar Wu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test \"test/*.test.js\"",
    "preview": "node scripts/preview-server.js",
    "dist:win": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.oscarwu.agentshome",
    "productName": "Agents Home",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Agent's Home",
      "artifactName": "AgentsHome-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "AgentsHome-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
